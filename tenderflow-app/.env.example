# TenderFlow local development — copy to .env and fill in when needed.
# No secrets are committed. Local-only stage: no hosted DB, no paid services.

# PostgreSQL running locally via Docker (configured at database setup phase)
# NOTE: use 127.0.0.1, not localhost — Docker Desktop on Windows can blackhole
# localhost resolution and stall connections past the driver timeout.
DATABASE_URL=postgresql://tenderflow:tenderflow@127.0.0.1:5432/tenderflow

# Better Auth (local-first, free/open-source)
BETTER_AUTH_SECRET=change-me-local-only
BETTER_AUTH_URL=http://localhost:3000

# Local MVP file storage (relative to tenderflow-app/)
UPLOADS_DIR=uploads

# Gemini API (free tier via Google AI Studio) — paste key after the = sign.
# Never commit a real key: .env is git-ignored and stays on your machine.
GEMINI_API_KEY=
